# Make manifest hashes portable across Windows and Linux checkouts.
* text=auto eol=lf

# Preserve generated model artifacts and FPGA test vectors byte-for-byte.
*.bin binary
*.npy binary
*.pt binary
*.pth binary
*.h5 binary
*.png binary
*.gif binary
*.zip binary
*.docx binary

# Keep source and documentation as normalized LF text.
*.py text
*.md text
*.json text
*.csv text
*.ps1 text
*.tcl text
*.cpp text
*.hpp text
*.h text
*.mem text eol=lf
*.coe text eol=lf

# Candidate bundle manifests hash exact file bytes; do not normalize its payload.
/experiments/hybrid_4k_20261006/candidate_delivery/R0_QAT456_seed456_20261007/** -text !eol
