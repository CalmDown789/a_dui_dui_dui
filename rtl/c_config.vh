//=============================================================================
// c_config.vh —— C 侧参数集中管理（单一真源 / Single Source of Truth）
//-----------------------------------------------------------------------------
// 设计基线（不得自行改动，改需 B/C 双向确认）：
//   · FSRCNN_ACX750-200T部署任务书_v3.2.2修订执行版        §五.3 / §五.4 / §五.7
//     §五.8 / §五.9 / §五.10 / §五.11
//   · 成员B对C架构接口与资源预算确认_v1.0                  §六 / §七 / §九
//
// 用法：
//   模块顶部 `include "c_config.vh"，再用
//     parameter integer IMG_W = `C_IMG_W
//   把下列常量作为「默认值」。模块本身仍保持参数化，便于小规模 TB 覆盖。
//
// 参数化纪律（用户指令 §四）：
//   · 凡是 B / A 尚未确认的量，一律 parameter 化 + TODO，不得凭空猜测；
//   · 本文件只放「已冻结」或「当前基线」的数值，并逐条标注出处。
//=============================================================================

`ifndef C_CONFIG_VH
`define C_CONFIG_VH

//-----------------------------------------------------------------------------
// 1. 图像尺寸与像素格式
//-----------------------------------------------------------------------------
// 输入：960×540 单通道 uint8 Y，行主序  —— v3.2.2 §五.9（1）+ B-ARCH-3
`define C_IMG_W            960
`define C_IMG_H            540
`define C_PIXEL_W          8

// 输出：1920×1080 uint8 Y（PixelShuffle 交织后的全分辨率光栅序）
//       —— v3.2.2 §五.8（1）；B 已做相位重排，C 侧不得再排
`define C_OUT_W            1920
`define C_OUT_H            1080

// 输出侧条带缓冲单位（**当前基线，非冻结项**）—— v3.2.2 §五.3 / §五.11
// 「64 行」= 输出侧条带缓冲单位，**不是**计算 tile。
// 变更须执行 §五.3「条带高度变更规程」五项重算 + B/C 双向确认。
`define C_STRIPE_H         64

//-----------------------------------------------------------------------------
// 2. 输入 ROM（C 侧实现，语义冻结）—— v3.2.2 §五.9（2）
//-----------------------------------------------------------------------------
// 深度：518400 像素；按 2 的幂填充到 524288（差额 5888 B ≈ 5.75 KiB 计入预算）
// 地址位宽 19 bit；地址语义 rom_addr = y*960 + x；填充区 518400~524287 内容 0x00
`define C_ROM_ADDR_W       19
`define C_ROM_DEPTH_POW2   524288

// 每帧输入像素数 = 960*540 = 518400（B-ARCH-3：B 每帧恰好接收 518400 个像素）
`define C_IN_PIXELS        (`C_IMG_W*`C_IMG_H)
// 每帧输出像素数 = 1920*1080 = 2073600（v3.2.2 §五.8（3））
`define C_OUT_PIXELS       (`C_OUT_W*`C_OUT_H)

//-----------------------------------------------------------------------------
// 3. 时钟与复位（C 侧基线，**已冻结**）—— v3.2.2 §五.4
//-----------------------------------------------------------------------------
// 板载 50MHz 有源晶振 W19 → MMCME2_BASE
//   CLKFBOUT_MULT_F=24.0 / DIVCLK_DIVIDE=1 / CLKOUT0_DIVIDE_F=6.0 / CLKIN1_PERIOD=20.0
//   VCO = 1200MHz → clk_200 = 200MHz
// 降频预案：CLKOUT0_DIVIDE_F 改 8.0 → 150MHz，接口不变
`define C_MMCM_CLKFBOUT_MULT_F   24.0
`define C_MMCM_DIVCLK_DIVIDE     1
`define C_MMCM_CLKOUT0_DIVIDE_F  6.0
`define C_MMCM_CLKIN1_PERIOD     20.0
`define C_CLK_IN_HZ              50000000
`define C_CLK_HZ                 200000000

// 复位：低有效 + MMCM locked 门控
//   sys_rst = rst_n_pressed_low | ~mmcm_locked
//   按键 S0 = D21（按下为低）；XDC 必须 set_false_path -from [get_ports rst_n]
`define C_RST_ACTIVE_LOW   1

//-----------------------------------------------------------------------------
// 4. UART 静态回读（离线验证链路）—— v3.2.2 §五.7
//-----------------------------------------------------------------------------
// 921600 8N1（10 bit/Byte）→ ≈22.5 s/帧，仅用于单帧上板 PSNR 验证。
//   🚫 不得用 UART 传输时间证明实时 FPS；UART 不参与 P3/P4 实时路径。
`define C_UART_BAUD        921600

//-----------------------------------------------------------------------------
// 5. 条带几何（**派生式**，跟随 C_STRIPE_H 自动更新）
//-----------------------------------------------------------------------------
// ⚠️ 审计修正（2026-09-23）：原先这里写死 `17` / `56`，一旦按 B-3 把
//    `C_STRIPE_H` 改成 32，这两个宏会**静默说谎**。现改为派生表达式。
//    它们只用于文档/核对，RTL 内不引用（RTL 用的是 output_stream 里的
//    localparam N_STRIPES / LAST_H，同样是展开期常量）。
//    H=64 时：C_STRIPE_CNT = ceil(1080/64) = 17；C_LAST_STRIPE_H = 1080-16*64 = 56
`define C_STRIPE_CNT       ((`C_OUT_H + `C_STRIPE_H - 1) / `C_STRIPE_H)
`define C_LAST_STRIPE_H    (`C_OUT_H - (((`C_OUT_H + `C_STRIPE_H - 1) / `C_STRIPE_H) - 1) * `C_STRIPE_H)
//    H=32 时应自动得：C_STRIPE_CNT = 34；C_LAST_STRIPE_H = 24（与 §五.3 参考核算一致）

//-----------------------------------------------------------------------------
// 6. TODO 清单（凡未确认项集中在此，实现处同步标注）
//-----------------------------------------------------------------------------
// TODO(B_CONFIRM): B-ARCH-10 的「最大连续 back-pressure 周期 N」尚未给出。
//   B 交付前，本工程只实现「标准 ready/valid 保持规则 + 有限长度背压」，
//   不假设任何具体 N 值；C18 的 N 相关用例在 B 回填后补测。
// TODO(A_CONFIRM): 全尺寸输入图 .mem（960×540 真实图像）属 A 侧交付物，
//   本工程只生成 tiny .mem 供小规模 TB；全尺寸装载待 A 给数据。
// TODO(UART_PIN_CONFIRM): CH9102 侧 FPGA 管脚未确认（v3.2.2 §五.5），
//   XDC 中 uart_tx 约束已注释保留，首次串口联通时用 IO Planner 确认后打开。
// TODO(B_CONFIRM): 条带高度若因 BRAM 闭合改 32 行（M1 方案），
//   须同步重算 stripe 数 / 末条带高度 / 双缓冲容量 / UART 分段 / 接口周期预算。

`endif // C_CONFIG_VH
