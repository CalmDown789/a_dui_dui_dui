#=============================================================================
# .gitignore —— C 侧 RTL 工程（FSRCNN ACX750-200T 集成）
#
# 原则：只忽略「构建产物 / 仿真产物 / 大型波形 / 临时文件」，
#       绝不忽略 .v / .sv / .vh / .xdc / .tcl / .xpr / .mem(小) / 文档。
#=============================================================================

#--- Vivado 工程与构建目录 ---------------------------------------------------
.Xil/
.runs/
.cache/
.hw/
.sim/
.ip_user_files/
.gen/
*.runs/
*.cache/

#--- Vivado 日志与报告（构建产物；需要入库的报告请放 report/ 并单独 add -f）----
*.jou
*.log
*.str
*.pb
*.dcp
*.bit
*.bin
*.ltx

#--- 波形（本项目默认禁止大量波形 dump）-------------------------------------
*.vcd
*.fst
*.wdb
*.vpd
*.wcfg
*.ghw
webtalk*.jou
webtalk*.log

#--- 仿真器工作目录 ---------------------------------------------------------
xsim.dir/
xelab.pb
xsim*.log
*.sim/
sim_work/
work/

#--- 本仓库自己的临时工作目录（仿真/综合现场，不入库） ----------------------
_sim/
/_sim_l5_member_b*/
_syn/
_synth_bc/
__pycache__/
*.pyc
*.log
*.log.*
/dfx_runtime.txt

# Member B simulation staging copies; authoritative banks remain tracked in
# member_b_evidence/real_banks/ and the A reference input under ref/.
/member_b_evidence/rom_tb/*.mem

#--- 大体积输入数据（全尺寸输入图 .mem 不入库，见 scripts/gen_input_mem.py）---
#  规则：tb/data/ 下的 tiny 数据入库；rtl 用的全尺寸 ROM 不入库
rtl/input_image_*.mem
rtl/*_full.mem
tb/data/*_full.mem

#--- Vivado 在启动目录自动落盘的文件（非人工产出，每次 route_design 重生）----
#   tight_setup_hold_pins.txt = 布局布线器给出的「setup/hold 紧张引脚」提示表，
#   属于工具副产物；放在启动目录（仓库根）会污染工作树，故排除。
#   需要留档时请把要点写进 report/impl/ 的说明文本，不要提交本文件。
tight_setup_hold_pins.txt

#--- 操作系统 / 编辑器 ------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*~
*.swp
*.bak
*.tmp
