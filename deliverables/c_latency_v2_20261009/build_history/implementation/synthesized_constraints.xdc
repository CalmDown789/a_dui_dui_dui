current_instance -quiet
current_instance u_video/u_tx_bridge/u_metadata
set_max_delay -datapath_only -from [filter [all_fanout -from [get_ports -scoped_to_current_instance -no_traverse wr_clk] -flat -endpoints_only] IS_LEAF] -through [get_pins -of_obj [get_cells -hier * -filter {PRIMITIVE_SUBGROUP==LUTRAM || PRIMITIVE_SUBGROUP==dram || PRIMITIVE_SUBGROUP==drom}] -filter DIRECTION==OUT] 6.667



# User Generated miscellaneous constraints 

current_instance -quiet
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CLKIN1_PERIOD 7.2 [get_cells u_clocks/u_rx_pll]

####################################################################################
# Constraints from file : 'external_io_candidate.xdc'
####################################################################################

# Conditional board envelope RX[-.30,+.45] TX[-.34,+.40] ns.
# RX PHY output setup/hold >=1.2ns, BUFIO follows actual duty.
# TX0 required clock-data window at PHY pins [1.0,2.6]ns.
create_generated_clock -name rgmii_tx_forward -source [get_pins u_io/u_tx/u_forward/C] -edges {2 4 6} [get_ports rgmii_txc]
set_input_delay -clock phy_rx125 -max 2.490 [get_ports {{rgmii_rxd[*]} rgmii_rxctl}]
set_input_delay -clock phy_rx125 -min -add_delay 0.900 [get_ports {{rgmii_rxd[*]} rgmii_rxctl}]
set_input_delay -clock phy_rx125 -clock_fall -max -add_delay 3.210 [get_ports {{rgmii_rxd[*]} rgmii_rxctl}]
set_input_delay -clock phy_rx125 -clock_fall -min -add_delay 0.900 [get_ports {{rgmii_rxd[*]} rgmii_rxctl}]
set_output_delay -clock rgmii_tx_forward -max 1.400 [get_ports {{rgmii_txd[*]} rgmii_txctl}]
set_output_delay -clock rgmii_tx_forward -min -add_delay -1.740 [get_ports {{rgmii_txd[*]} rgmii_txctl}]
set_output_delay -clock rgmii_tx_forward -clock_fall -max -add_delay 1.400 [get_ports {{rgmii_txd[*]} rgmii_txctl}]
set_output_delay -clock rgmii_tx_forward -clock_fall -min -add_delay -1.740 [get_ports {{rgmii_txd[*]} rgmii_txctl}]
set_load 12.000 [get_ports {{rgmii_txd[*]} rgmii_txctl rgmii_txc}]
set_property LOAD 12 [get_ports {rgmii_txd[3]}]
set_property LOAD 12 [get_ports {rgmii_txd[2]}]
set_property LOAD 12 [get_ports {rgmii_txd[1]}]
set_property LOAD 12 [get_ports {rgmii_txd[0]}]
set_property LOAD 12 [get_ports rgmii_txctl]
set_property LOAD 12 [get_ports rgmii_txc]
set_property SLEW FAST [get_ports {{rgmii_txd[*]} rgmii_txctl rgmii_txc}]
set_property DRIVE 8 [get_ports {{rgmii_txd[*]} rgmii_txctl}]
set_property DRIVE 12 [get_ports rgmii_txc]


# User Generated XDC timing constraints 

set_clock_uncertainty 0.100 [all_clocks]
set_clock_uncertainty -from [get_clocks phy_rx125] -to [get_clocks phy_rx125] 0.000
set_clock_uncertainty -from [get_clocks -of_objects [get_pins u_io/u_tx/u_forward/C]] -to [get_clocks rgmii_tx_forward] 0.000
create_generated_clock -name mdc_out -source [get_ports sys_clk50] -divide_by 500 [get_ports mdc]
set_output_delay -clock mdc_out -max 10.000 [get_ports mdio]
set_output_delay -clock mdc_out -min -10.000 [get_ports mdio]
set_false_path -from [get_ports mdio] -to [get_pins u_management/u_startup/u_mdio/mdio_meta_q_reg/D]
set_multicycle_path -setup -start -from [get_cells {u_management/u_startup/u_mdio/mdio_out_q_reg u_management/u_startup/u_mdio/mdio_oe_q_reg}] -to [get_ports mdio] 250
set_multicycle_path -hold -start -from [get_cells {u_management/u_startup/u_mdio/mdio_out_q_reg u_management/u_startup/u_mdio/mdio_oe_q_reg}] -to [get_ports mdio] 249
set_false_path -to [get_ports uart_tx]
set_false_path -through [get_pins {u_clocks/u_sys_mmcm/LOCKED u_clocks/u_rx_pll/LOCKED u_clocks/u_ref_mmcm/LOCKED}]
set_false_path -to [get_pins [list {rr_reg[0]/PRE} {rr_reg[1]/PRE} {tr_reg[0]/PRE} {tr_reg[1]/PRE} {u_video/u_rx_bridge/rd_reset_q_reg[0]/PRE} {u_video/u_rx_bridge/rd_reset_q_reg[1]/PRE}]]
set_false_path -to [get_pins [list {u_clocks/bad_sync_reg[0]/PRE} {u_clocks/bad_sync_reg[1]/PRE}]]
set_false_path -to [get_pins [list {u_io/u_tx/release_sync_reg[0]/PRE} {u_io/u_tx/release_sync_reg[1]/PRE}]]
set_false_path -through [get_pins u_clocks/u_delay_control/RDY] -to [get_pins {u_clocks/delay_ready_sync_reg[0]/D}]

# User Generated miscellaneous constraints 

create_waiver -type CDC -id {CDC-10} -user "ACX750_root" -desc "Terminal sticky single-bit PHY permission enters an async-assert two-stage reset synchronizer, then 1024 core cycles. The fault OR is not a data crossing. Stage D and all reset consumers remain timed." -tags "ACX750_PHY_TERMINAL_PERMISSION_FAULT" -from {u_clocks/delay_reset_count_reg[3]/C} -to {u_clocks/delay_reset_count_reg[3]/C} -timestamp "Fri Oct  9 12:01:32 GMT 2026"
create_waiver -type CDC -id {CDC-10} -user "ACX750_root" -desc "Source-bound registered IDELAYCTRL reset is an intentional asynchronous fault request, asserted for at least 64 stable ref200 edges. Release passes the verified zero-shift core reset synchronizer and 1024 cycles. Source D/CE, reference reset recovery/removal and all consumers remain timed." -tags "ACX750_REGISTERED_CALIBRATION_FAULT" -from {u_clocks/delay_reset_count_reg[3]/C} -to {u_clocks/delay_reset_count_reg[3]/C} -timestamp "Fri Oct  9 12:01:33 GMT 2026"

# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
