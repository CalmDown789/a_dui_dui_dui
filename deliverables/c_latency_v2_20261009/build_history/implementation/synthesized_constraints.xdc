current_instance -quiet
current_instance u_video/u_rx_bridge/u_metadata
set_max_delay -datapath_only -from [filter [all_fanout -from [get_ports -scoped_to_current_instance -no_traverse wr_clk] -flat -endpoints_only] IS_LEAF] -through [get_pins -of_obj [get_cells -hier * -filter {PRIMITIVE_SUBGROUP==LUTRAM || PRIMITIVE_SUBGROUP==dram || PRIMITIVE_SUBGROUP==drom}] -filter DIRECTION==OUT] 7.200


